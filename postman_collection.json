{
	"info": {
		"_postman_id": "medstore-api-collection-2026",
		"name": "Medical Equipment E-Commerce API",
		"description": "Production API Postman Collection for Go + Gin Medical Equipment E-Commerce Platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register Doctor User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"doctor@hospital.org\",\n  \"full_name\": \"Dr. Sarah Jenkins\",\n  \"password\": \"DoctorPass123!\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/register", "host": ["{{baseUrl}}"], "path": ["api", "register"] }
					}
				},
				{
					"name": "Login Admin",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@medstore.local\",\n  \"password\": \"AdminPass123!\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/login", "host": ["{{baseUrl}}"], "path": ["api", "login"] }
					}
				},
				{
					"name": "Get Current User Profile",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api", "me"] }
					}
				}
			]
		},
		{
			"name": "Categories & Products",
			"item": [
				{
					"name": "List Categories",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
					}
				},
				{
					"name": "List Products (Filtered & Search)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/products?q=X-Ray&is_refurbished=false&sort=price_asc",
							"host": ["{{baseUrl}}"],
							"path": ["api", "products"],
							"query": [
								{ "key": "q", "value": "X-Ray" },
								{ "key": "is_refurbished", "value": "false" },
								{ "key": "sort", "value": "price_asc" }
							]
						}
					}
				},
				{
					"name": "Get Product Detail by ID",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] }
					}
				},
				{
					"name": "Create Product (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sku\": \"ECG-300\",\n  \"name\": \"Portable 12-Channel ECG Machine\",\n  \"description\": \"Compact ECG recorder with thermal printer and automatic arrhythmia diagnosis.\",\n  \"category_id\": 2,\n  \"is_refurbished\": false,\n  \"warranty_months\": 12,\n  \"price_cents\": 95000,\n  \"currency\": \"USD\",\n  \"inventory\": 20\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
					}
				},
				{
					"name": "Adjust Product Inventory (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"delta\": 10\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/products/1/inventory", "host": ["{{baseUrl}}"], "path": ["api", "products", "1", "inventory"] }
					}
				}
			]
		},
		{
			"name": "Cart & Wishlist",
			"item": [
				{
					"name": "Get User Cart",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
						"url": { "raw": "{{baseUrl}}/api/cart", "host": ["{{baseUrl}}"], "path": ["api", "cart"] }
					}
				},
				{
					"name": "Add Item to Cart",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"product_id\": 1,\n  \"quantity\": 2\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/cart/items", "host": ["{{baseUrl}}"], "path": ["api", "cart", "items"] }
					}
				},
				{
					"name": "Add Item to Wishlist",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"product_id\": 1\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/wishlist", "host": ["{{baseUrl}}"], "path": ["api", "wishlist"] }
					}
				}
			]
		},
		{
			"name": "Orders & Checkout",
			"item": [
				{
					"name": "Checkout & Create Order",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"payment_method\": \"demo_credit_card\",\n  \"shipping_address\": \"ICU Ward, Metro Hospital, CA\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
					}
				},
				{
					"name": "List User Orders",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
						"url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
					}
				},
				{
					"name": "List All Admin Orders",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
						"url": { "raw": "{{baseUrl}}/api/admin/orders", "host": ["{{baseUrl}}"], "path": ["api", "admin", "orders"] }
					}
				},
				{
					"name": "Get Admin Dashboard Stats",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
						"url": { "raw": "{{baseUrl}}/api/admin/stats", "host": ["{{baseUrl}}"], "path": ["api", "admin", "stats"] }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "jwtToken", "value": "" }
	]
}
